{
  "displayName": "Trio E",
  "name": "homebridge-trio-e",
  "version": "2.0.0",
  "description": "Plugin for Viega's Multiplex Trio E bath control system",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxelTerizaki/homebridge-plugin-trio-e"
  },
  "bugs": {
    "url": "https://github.com/AxelTerizaki/homebridge-plugin-trio-e/issues"
  },
  "engines": {
    "node": "^24.15.0",
    "homebridge": "^1.5.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "prettier": "prettier -w src/"
  },
  "keywords": [
    "homebridge-plugin",
    "trio",
    "multiplex",
    "viega",
    "bath"
  ],
  "dependencies": {
    "axios": "^1.16.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.8.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "homebridge": "^2.0.2",
    "homebridge-config-ui-x": "^5.23.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "singleQuote": true
  }
}
